generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model categoria {
  idcategoria     Int               @id(map: "categoria_pk") @default(autoincrement())
  nombre          String            @db.VarChar(50) @unique
  recetacategoria recetacategoria[]
}

model ingrediente {
  idingrediente     Int                 @id(map: "ingrediente_pk") @default(autoincrement())
  nombre            String              @db.VarChar(100) @unique
  recetaingrediente recetaingrediente[]
}

model paso {
  idpaso          Int    @id(map: "paso_pk") @default(autoincrement())
  descripcion     String @db.VarChar(500)
  receta_idreceta Int
  numeropaso      Int
  receta          receta @relation(fields: [receta_idreceta], references: [idreceta], onDelete: NoAction, onUpdate: NoAction, map: "paso_receta_fk")
}

model receta {
  idreceta          Int                 @id(map: "receta_pk") @default(autoincrement())
  nombre            String              @db.VarChar(100)
  descripcion       String?             @db.VarChar(500)
  tiempopreparacion String              @db.VarChar(30)
  calorias          String              @db.VarChar(10)
  imagenreceta      Bytes?
  image_url         String?             
  video_url         String?
  estado  String  @default("borrador") @db.VarChar(20)
  fechacreacion     DateTime            @db.Date
  paso              paso[]
  recetacategoria   recetacategoria[]
  recetaguardada    recetaguardada[]
  recetaingrediente recetaingrediente[]
  id_usuariocreador  Int?
  usuario           usuario? @relation(fields: [id_usuariocreador], references: [idusuario])               
}

model recetacategoria {
  receta_idreceta       Int
  categoria_idcategoria Int
  categoria             categoria @relation(fields: [categoria_idcategoria], references: [idcategoria], onDelete: NoAction, onUpdate: NoAction, map: "recetaingrediente_categoria_fk")
  receta                receta    @relation(fields: [receta_idreceta], references: [idreceta], onDelete: NoAction, onUpdate: NoAction, map: "recetaingrediente_receta_fk")

  @@id([receta_idreceta, categoria_idcategoria], map: "recetacategoria_pk")
}

model recetaguardada {
    fecha_guardado    DateTime? @db.Date
    usuario_idusuario Int
    receta_idreceta   Int
    receta            receta  @relation(fields: [receta_idreceta], references: [idreceta], onDelete: NoAction, onUpdate: NoAction, map: "recetaguardada_receta_fk")
    usuario           usuario @relation(fields: [usuario_idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction, map: "recetaguardada_usuario_fk")
    @@id([usuario_idusuario, receta_idreceta], map: "recetaguardada_pk")
}

model recetaingrediente {
  receta_idreceta           Int
  ingrediente_idingrediente Int
  cantidadingrediente       String?     @db.VarChar(20)
  ingrediente               ingrediente @relation(fields: [ingrediente_idingrediente], references: [idingrediente], onDelete: NoAction, onUpdate: NoAction, map: "recetacategoria_ingrediente_fk")
  receta                    receta      @relation(fields: [receta_idreceta], references: [idreceta], onDelete: NoAction, onUpdate: NoAction, map: "recetacategoria_receta_fk")

  @@id([receta_idreceta, ingrediente_idingrediente], map: "recetaingrediente_pk")
}

model usuario {
  idusuario                 Int             @id(map: "usuario_pk") @default(autoincrement())
  nickname                  String          @unique   @db.VarChar(30)
  username                  String?         @db.VarChar(30)
  profile_picture_url       String?         @db.VarChar(500)
  email                     String          @db.VarChar(50)
  contrasena                String          @db.VarChar(255)
  fecha_registro            DateTime?       @db.Date
  fotoperfil                Bytes?
  recetaguardada            recetaguardada[]
  recetas                   receta[]
  rol                       String   @default("usuario")  
}
